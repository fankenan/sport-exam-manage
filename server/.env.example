# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sport_app
DB_PASSWORD=请填写你的数据库口令
DB_NAME=sport_manage

# ===== JWT =====
# 必填；建议 >= 32 位随机串，例如 openssl rand -hex 32
JWT_SECRET=请换成一个随机字符串
JWT_EXPIRES_IN=2h

# ===== 服务 =====
PORT=4000
# production 会启用一次性初始口令、禁止默认弱口令；本机演示可用 development
NODE_ENV=development

# 允许的跨域来源（逗号分隔）；前后端同源部署时可以留空
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000,http://127.0.0.1:4000
