@echo off
REM ============================================================
REM  本机私有配置（示例）
REM
REM  复制本文件为 local.env.cmd，填入你自己的 MySQL root 口令。
REM  local.env.cmd 已在 .gitignore 中，不会被提交。
REM
REM  注意：口令里如果有 ^ & | < > ( ) 等特殊字符，需要写成 ^ 转义。
REM ============================================================
set "MYSQL_ROOT_PWD=你的MySQL_root口令"
